{
  "name": "Bambinos AI Live Class Content Mining Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bambinos-class-ingest",
        "options": {}
      },
      "id": "node-webhook-1",
      "name": "Class Recording Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "session_id",
              "value": "={{ $json.body.session_id }}"
            },
            {
              "name": "subject",
              "value": "={{ $json.body.subject }}"
            },
            {
              "name": "video_url",
              "value": "={{ $json.body.video_url }}"
            },
            {
              "name": "transcript_vtt_url",
              "value": "={{ $json.body.transcript_vtt_url }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-set-vars",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.transcript_vtt_url }}",
        "responseFormat": "string"
      },
      "id": "node-fetch-vtt",
      "name": "Fetch WebVTT Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [500, 300]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20241022",
        "prompt": "=Analyze this Bambinos classroom transcript for Session {{ $('Normalize Payload').item.json.session_id }} ({{ $('Normalize Payload').item.json.subject }}).\n\nTranscript Content:\n{{ $json.data }}\n\nIdentify the top 1 to 3 unscripted 10-25 second marketing moments. Follow the Bambinos Creative Taxonomy and 100-Point Scoring Rubric. Output strict JSON array of candidate moments.",
        "temperature": 0.2
      },
      "id": "node-llm-mining",
      "name": "AI Moment Mining Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.4,
      "position": [700, 300]
    },
    {
      "parameters": {
        "command": "=python /opt/scripts/verify_video_frames.py --video_url \"{{ $('Normalize Payload').item.json.video_url }}\" --moments '{{ JSON.stringify($json.candidates) }}'"
      },
      "id": "node-opencv-verify",
      "name": "OpenCV Visual Verifier",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [950, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.total_score }}",
              "operation": "largerEqual",
              "value2": 80
            }
          ],
          "boolean": [
            {
              "value1": "={{ $json.hard_compliance_fail }}",
              "value2": false
            }
          ]
        }
      },
      "id": "node-filter-gate",
      "name": "Quality & Compliance Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1150, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "application": "appBambinosMarketing",
        "table": "Editor_Ad_Briefs",
        "columns": {
          "fields": {
            "Clip_ID": "={{ $json.clip_id }}",
            "Session_ID": "={{ $('Normalize Payload').item.json.session_id }}",
            "Subject": "={{ $('Normalize Payload').item.json.subject }}",
            "Start_Time": "={{ $json.start_timestamp }}",
            "End_Time": "={{ $json.end_timestamp }}",
            "Hook_3s": "={{ $json.three_second_hook }}",
            "Bucket": "={{ $json.moment_bucket }}",
            "Verbatim_Dialogue": "={{ $json.verbatim_dialogue }}",
            "Score": "={{ $json.total_score }}",
            "Geography": "={{ $json.geography_fit }}",
            "Visual_Status": "={{ $json.visual_status }}",
            "Editor_Notes": "={{ $json.editor_instructions }}",
            "Status": "Ready for Editing"
          }
        }
      },
      "id": "node-airtable-create",
      "name": "Create Airtable Ad Brief",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [1400, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "application": "appBambinosMarketing",
        "table": "Quality_Assurance_Logs",
        "columns": {
          "fields": {
            "Session_ID": "={{ $('Normalize Payload').item.json.session_id }}",
            "Reason": "={{ $json.rejection_reason }}",
            "Tone_Flag": "={{ $json.tone_flag }}",
            "PII_Flag": "={{ $json.pii_flag }}",
            "Action": "Escalate to Academic QA"
          }
        }
      },
      "id": "node-airtable-qa",
      "name": "Log Rejection & QA Alert",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [1400, 450]
    },
    {
      "parameters": {
        "channel": "#marketing-ad-briefs",
        "text": "=🚀 *New High-Priority Ad Brief Ready!*\n*Clip:* {{ $json.clip_id }} ({{ $('Normalize Payload').item.json.subject }})\n*Score:* {{ $json.total_score }}/100\n*Hook:* \"{{ $json.three_second_hook }}\"\n*Geography:* {{ $json.geography_fit }}\nCheck Airtable to start editing: https://airtable.com/appBambinosMarketing"
      },
      "id": "node-slack-notify",
      "name": "Notify Video Editors in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [1650, 200]
    }
  ],
  "connections": {
    "Class Recording Webhook": {
      "main": [
        [
          {
            "node": "Normalize Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Payload": {
      "main": [
        [
          {
            "node": "Fetch WebVTT Transcript",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch WebVTT Transcript": {
      "main": [
        [
          {
            "node": "AI Moment Mining Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Moment Mining Agent": {
      "main": [
        [
          {
            "node": "OpenCV Visual Verifier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenCV Visual Verifier": {
      "main": [
        [
          {
            "node": "Quality & Compliance Gate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Quality & Compliance Gate": {
      "main": [
        [
          {
            "node": "Create Airtable Ad Brief",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Rejection & QA Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Airtable Ad Brief": {
      "main": [
        [
          {
            "node": "Notify Video Editors in Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}

